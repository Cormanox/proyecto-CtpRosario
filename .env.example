# =============================================================================
# VARIABLES DE ENTORNO — CTP ROSARIO DE NARANJO
# Copia este archivo como .env para personalizar tu entorno local o de producción
# =============================================================================

# Configuración de Conexión a Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ctp_rosario
DB_USER=root
DB_PASS=mysql
DB_CHARSET=utf8mb4

# Entorno de la Aplicación (development | production)
APP_ENV=development

# Configuración de URLs (opcional, detección automática por defecto)
# BASE_URL=/proyecto-CtpRosario

